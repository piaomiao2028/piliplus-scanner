<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.piaomiao.pilipala.scan"
    android:versionCode="1"
    android:versionName="1.0">

    <uses-sdk android:minSdkVersion="21" android:targetSdkVersion="33" />

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="com.piaomiao.pilipala.scan.permission.QR_RESULT" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- 扫码结果回传给宿主进程时用的自定义权限：签名级，别的应用发不了假广播 -->
    <permission
        android:name="com.piaomiao.pilipala.scan.permission.QR_RESULT"
        android:protectionLevel="signature" />

    <queries>
        <package android:name="com.guozhigq.pilipala" />
        <package android:name="com.example.piliplus" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="bilibili" />
        </intent>
        <intent>
            <action android:name="android.intent.action.GET_CONTENT" />
            <data android:mimeType="image/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.OPEN_DOCUMENT" />
            <data android:mimeType="image/*" />
        </intent>
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:hasCode="true">

        <activity
            android:name=".ScannerActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <meta-data android:name="xposedmodule" android:value="true" />
        <meta-data
            android:name="xposeddescription"
            android:value="给 PiLiPala / PiliPlus 加扫码：悬浮球扫 BV·av·短链直接进视频页，扫登录码用当前账号确认登录" />
        <meta-data android:name="xposedminversion" android:value="54" />
        <meta-data android:name="xposedscope" android:resource="@array/xposedscope" />
    </application>
</manifest>
